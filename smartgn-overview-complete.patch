new file mode 100644
index 0000000..ec9f5dd
--- /dev/null
+++ b/src/app/shared/application/language.service.ts
@@ -0,0 +1,55 @@
+import { DOCUMENT } from '@angular/common';
+import { Injectable, inject, signal } from '@angular/core';
+import { TranslateService } from '@ngx-translate/core';
+
+export type AppLanguage = 'en' | 'es';
+
+export const APP_LANGUAGES: { code: AppLanguage; label: string }[] = [
+  { code: 'en', label: 'English' },
+  { code: 'es', label: 'Español' },
+];
+
+const STORAGE_KEY = 'smartgn-lang';
+
+/*
+  Owns the UI language. ngx-translate does the actual lookup; this service only
+  picks the initial language (saved choice, then browser language), persists
+  changes and keeps <html lang> in sync.
+*/
+@Injectable({ providedIn: 'root' })
+export class LanguageService {
+  private readonly translate = inject(TranslateService);
+  private readonly document = inject(DOCUMENT);
+
+  private readonly langSignal = signal<AppLanguage>('en');
+  readonly lang = this.langSignal.asReadonly();
+
+  constructor() {
+    this.apply(this.readInitial());
+  }
+
+  set(lang: AppLanguage): void {
+    this.apply(lang);
+    try {
+      localStorage.setItem(STORAGE_KEY, lang);
+    } catch {
+      // Storage can be blocked; the language still applies for this session.
+    }
+  }
+
+  private readInitial(): AppLanguage {
+    try {
+      const stored = localStorage.getItem(STORAGE_KEY);
+      if (stored === 'en' || stored === 'es') return stored;
+    } catch {
+      // ignore and detect from the browser
+    }
+    return navigator.language?.toLowerCase().startsWith('es') ? 'es' : 'en';
+  }
+
+  private apply(lang: AppLanguage): void {
+    this.langSignal.set(lang);
+    this.translate.use(lang);
+    this.document.documentElement.lang = lang;
+  }
+}
diff --git a/src/app/shared/application/theme.service.ts b/src/app/shared/application/theme.service.ts
new file mode 100644
index 0000000..b1561e8
--- /dev/null
+++ b/src/app/shared/application/theme.service.ts
@@ -0,0 +1,64 @@
+import { DOCUMENT } from '@angular/common';
+import { Injectable, inject, signal } from '@angular/core';
+
+export type ThemeMode = 'dark' | 'light';
+
+const STORAGE_KEY = 'smartgn-theme';
+const THEME_COLORS: Record<ThemeMode, string> = {
+  dark: '#080d0a',
+  light: '#e2dfdd',
+};
+
+/*
+  Owns the light/dark mode of the whole app.
+
+  The mode is stored on <html data-theme="..."> so material-theme.scss can swap
+  every --smartgn-* token and the Material system tokens at once. The choice is
+  persisted in localStorage; dark stays the default product theme.
+*/
+@Injectable({ providedIn: 'root' })
+export class ThemeService {
+  private readonly document = inject(DOCUMENT);
+
+  private readonly modeSignal = signal<ThemeMode>(this.readStored());
+  readonly mode = this.modeSignal.asReadonly();
+
+  constructor() {
+    this.apply(this.modeSignal());
+  }
+
+  toggle(): void {
+    this.set(this.modeSignal() === 'dark' ? 'light' : 'dark');
+  }
+
+  set(mode: ThemeMode): void {
+    this.modeSignal.set(mode);
+    this.apply(mode);
+    try {
+      localStorage.setItem(STORAGE_KEY, mode);
+    } catch {
+      // Storage can be blocked (private mode); the theme still applies for this session.
+    }
+  }
+
+  private readStored(): ThemeMode {
+    try {
+      const stored = localStorage.getItem(STORAGE_KEY);
+      if (stored === 'light' || stored === 'dark') return stored;
+    } catch {
+      // ignore and fall back to the default
+    }
+    return 'dark';
+  }
+
+  private apply(mode: ThemeMode): void {
+    const root = this.document.documentElement;
+    root.setAttribute('data-theme', mode);
+    this.document
+      .querySelector('meta[name="color-scheme"]')
+      ?.setAttribute('content', mode);
+    this.document
+      .querySelector('meta[name="theme-color"]')
+      ?.setAttribute('content', THEME_COLORS[mode]);
+  }
+}
